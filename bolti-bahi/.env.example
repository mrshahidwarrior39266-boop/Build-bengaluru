# Gnani API Platform key (Prisma v3.0 STT + Timbre v3.0 TTS).
# Optional for local demos: without it the browser falls back to the Web Speech
# API for recognition and speech synthesis, and /api/health reports stt:false.
GNANI_API_KEY=
# Natural human-like speech settings:
# Voice choices: Shivani (warm female), Aditya (natural male)
GNANI_TTS_VOICE=Shivani
GNANI_TTS_SPEED=0.94
GNANI_TTS_LANGUAGE=hi-IN

# Free LLM "brain" for sentences the deterministic parser cannot read.
# Set either GROQ_API_KEY (free from console.groq.com) or GEMINI_API_KEY (free from aistudio.google.com).
# Provider is auto-detected!
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_API_KEY=
LLM_PROVIDER=groq
# assist (default): help only when a name/direction/parse is missing.
# fallback: only when the sentence is completely unreadable. off: never call.
LLM_MODE=assist
# Override only when a provider renames a model:
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=3000

PORT=3000

# Gnani streaming language. Use indic-auto for mixed-language shops, or a
# specific locale such as hi-IN, bn-IN, ta-IN, mr-IN, ...
GNANI_LANGUAGE=hi-IN
GNANI_TOPIC=kirana dukaan ka khata, udhaar aur jama hisaab
# VAD preset for a noisy counter (raise threshold/min-speech to reject more noise).
GNANI_VAD_THRESHOLD=0.65
GNANI_MIN_SPEECH_MS=200
GNANI_MIN_SILENCE_MS=500
GNANI_MIN_SEGMENT_MS=200

# Google login. Leave both blank for a public demo with no sign-in.
# Create an OAuth 2.0 Web client in Google Cloud Console and add the redirect
# URI below to its "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the deployed origin, e.g.
# https://bolti-bahi-production.up.railway.app/auth/google/callback
# Leave blank to derive it from the request.
GOOGLE_REDIRECT_URI=

# Where the local ledger lives. Defaults to ./bolti-bahi.db
KHATA_DB=

# Per-shop ledger files and account metadata. Defaults to stores.db and
# ./stores next to KHATA_DB.
STORE_DB=
STORE_DATA_DIR=
# Shown on the login page and in the app for a brand-new shop.
STORE_NAME=Meri Dukaan

# 32-byte transcript encryption key (64 hex chars or base64).
# Leave empty to auto-generate a local .bolti-bahi-key file with mode 0600.
# Never commit this value.
TRANSCRIPT_KEY=

# Spoken transcripts are deleted this many minutes after they are recorded.
TRANSCRIPT_RETENTION_MINUTES=120

# Allow POST /api/reset to wipe the demo ledger. Keep 0 in public demos.
ENABLE_RESET=0
